{
    "version":  1,
    "projects":  {
                     "babySami":  {
                                      "projectType":  "application",
                                      "root":  "",
                                      "sourceRoot":  "src",
                                      "architect":  {
                                                        "build":  {
                                                                      "builder":  "@angular/build:application",
                                                                      "options":  {
                                                                                      "browser":  "src/main.ts",
                                                                                      "tsConfig":  "tsconfig.json",
                                                                                      "index":  "src/index.html",
                                                                                      "styles":  [
                                                                                                     "src/styles.css"
                                                                                                 ],
                                                                                      "assets":  [
                                                                                                     {
                                                                                                         "glob":  "**/*",
                                                                                                         "input":  "public"
                                                                                                     },
                                                                                                     {
                                                                                                         "glob":  "**/*",
                                                                                                         "input":  "src/assets",
                                                                                                         "output":  "assets"
                                                                                                     }
                                                                                                 ],
                                                                                      "outputPath":  "dist/babySami"
                                                                                  },
                                                                      "configurations":  {
                                                                                             "production":  {
                                                                                                                "outputHashing":  "all",
                                                                                                                "budgets":  [
                                                                                                                                {
                                                                                                                                    "type":  "initial",
                                                                                                                                    "maximumWarning":  "600kB",
                                                                                                                                    "maximumError":  "1MB"
                                                                                                                                }
                                                                                                                            ]
                                                                                                            },
                                                                                             "development":  {
                                                                                                                 "optimization":  false,
                                                                                                                 "sourceMap":  true
                                                                                                             }
                                                                                         },
                                                                      "defaultConfiguration":  "production"
                                                                  },
                                                        "serve":  {
                                                                      "builder":  "@angular/build:dev-server",
                                                                      "configurations":  {
                                                                                             "development":  {
                                                                                                                 "buildTarget":  "babySami:build:development"
                                                                                                             }
                                                                                         },
                                                                      "defaultConfiguration":  "development"
                                                                  }
                                                    }
                                  }
                 }
}